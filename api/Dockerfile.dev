# Development image: gems are installed in a volume, code is bind-mounted.
ARG RUBY_VERSION=3.4.7
FROM docker.io/library/ruby:$RUBY_VERSION-slim

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential git libpq-dev libyaml-dev pkg-config curl && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

WORKDIR /rails
ENV BUNDLE_PATH=/usr/local/bundle

EXPOSE 3000
CMD ["bash", "-c", "bundle check || bundle install; bin/rails db:prepare && rm -f tmp/pids/server.pid && bin/rails server -b 0.0.0.0"]
